{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "node",
    "promise",
    "import",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {},
  "overrides": [
    {
      "files": ["*.test.ts", "*.spec.ts", "*.test.js", "*.spec.js"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/**", "build/**", "coverage/**", "node_modules/**"]
}
