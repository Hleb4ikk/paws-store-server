# Copy this file to `.env` and fill in the real values.

# HTTP server
APP_PORT=3000
APP_HOST=0.0.0.0

# PostgreSQL connection string (PostgreSQL >= 15).
# In docker compose the host is `postgres`; locally it is `localhost`.
DATABASE_URL="postgresql://paws-store-user:paws-store-password@localhost:5432/paws-store-db"

# JWT authentication
JWT_SECRET="super-secret-change-me"
JWT_EXPIRES_IN="7d"

# Redis catalog cache.
# In docker compose the host is `redis`; locally it is `localhost`.
REDIS_URL="redis://localhost:6379"
# Cache TTL in seconds (60-120 recommended)
CACHE_TTL_SECONDS=90

# CORS — comma-separated list of allowed origins, or * for any
CORS_ORIGIN="*"

# Cloudflare R2 (S3-compatible) product image storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Seed script admin credentials
SEED_ADMIN_EMAIL="admin@paws.store"
SEED_ADMIN_PASSWORD="admin123"
